{
  "manifest_version": 3,
  "name": "Dante Plus",
  "version": "2.0",
  "description": "Rozwiązuje zadania z AI i wkleja pliki.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"]
    }
  ]
}