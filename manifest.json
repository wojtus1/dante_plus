{
  "manifest_version": 3,
  "name": "Dante Plus",
  "version": "2.5",
  "description": "Rozwiązuje zadania z AI i wkleja pliki.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["ai_autorun.js"]
    }
  ]
}
